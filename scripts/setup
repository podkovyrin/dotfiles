#!/bin/bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Set up this Apple Silicon Mac: install the missing prerequisites (Xcode' \
    'Command Line Tools, Nix, Homebrew), then build and apply the configuration.' \
    '' \
    'Usage: bash -c "$(curl -fsSL https://raw.githubusercontent.com/podkovyrin/dotfiles/master/scripts/setup)"' \
    '' \
    'Run as your normal user, without sudo. Installers and activation request access.' \
    'After setup, use ./n apply. See README.md.'
}

case "$#:${1:-}" in
  0:) ;;
  1:-h|1:--help) usage; exit 0 ;;
  *) printf 'Unknown arguments: %s. Use --help.\n' "$*" >&2; exit 2 ;;
esac

fail() {
  printf '%s\n' "$@" >&2
  exit 1
}

[[ $(id -u) != 0 ]] || fail 'Run this command as your normal user, without sudo.'
[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] ||
  fail 'Run this setup in a native Apple Silicon macOS shell.'
macos=$(/usr/bin/sw_vers -productVersion)
(( ${macos%%.*} >= 14 )) || fail 'This setup requires macOS 14 or newer.'

repo=$(cd -- "$(dirname -- "$0")/.." && pwd -P)
flake="path:$repo/nix"
build="$repo/.build"

may_install() {
  [[ -t 0 && -t 2 ]] || fail "Installing $1 requires an interactive terminal. Run the setup there."
}

ensure_clt() {
  /usr/bin/xcode-select -p >/dev/null 2>&1 && return
  may_install 'Xcode Command Line Tools'
  printf 'Requesting Xcode Command Line Tools. Complete the Apple installer dialog.\n' >&2
  /usr/bin/xcode-select --install
  printf 'Waiting up to 15 minutes for the developer tools. Interrupt to stop waiting.\n' >&2
  for _ in {1..180}; do
    /usr/bin/xcode-select -p >/dev/null 2>&1 && return
    sleep 5
  done
  fail 'Developer tools are not ready. Finish the Apple installation, then run the setup again.'
}

find_nix() {
  command -v nix || { [[ -x /nix/var/nix/profiles/default/bin/nix ]] &&
    printf '%s\n' /nix/var/nix/profiles/default/bin/nix; }
}

ensure_nix() {
  [[ ! -e /usr/local/bin/determinate-nixd ]] ||
    fail 'Determinate manages this Nix daemon. This configuration requires nix-darwin daemon ownership.' \
      'Resolve the daemon ownership manually. No replacement or installation ran.'
  find_nix >/dev/null && return
  may_install Nix

  # Keep this at the version of nix.package in nix/darwin.nix
  # (pkgs.nixVersions.latest in the locked Nixpkgs). nix-darwin replaces the
  # installed Nix with that one, and a downgrade is not supported.
  local url='https://releases.nixos.org/nix/nix-2.35.2/install'
  local sha256='9adda97297d9e8ab360df95c729eabff4f4f93d6db091953c3a68f29e3fb130c'
  local installer="$build/bootstrap/nix-install.sh"
  mkdir -p "${installer%/*}"
  if [[ $(/usr/bin/shasum -a 256 "$installer" 2>/dev/null) != "$sha256 "* ]]; then
    printf 'Downloading the pinned Nix installer.\n' >&2
    /usr/bin/curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
      --output "$installer.partial" "$url"
    [[ $(/usr/bin/shasum -a 256 "$installer.partial") == "$sha256 "* ]] || {
      rm -f "$installer.partial"
      fail 'SHA256 mismatch for the Nix installer. The installer was not executed.'
    }
    mv -f "$installer.partial" "$installer"
  fi
  printf 'Installing official multi-user Nix. Follow its administrator prompts.\n' >&2
  (unset CI NONINTERACTIVE NIX_INSTALLER_YES; /bin/sh "$installer" --daemon --no-channel-add)
  find_nix >/dev/null ||
    fail 'The installer finished, but Nix was not found. Inspect its output before retrying.'
}

ensure_brew() {
  [[ -x /opt/homebrew/bin/brew ]] && return
  local existing
  if existing=$(command -v brew); then
    fail "This configuration requires Homebrew at /opt/homebrew. Existing executable: $existing" \
      'Resolve the Homebrew prefix manually. No second installation ran.'
  fi
  may_install Homebrew

  local installer developer status=0
  installer=$(/usr/bin/curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
    'https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh')
  developer=$(/usr/bin/xcode-select -p)
  printf 'Installing Homebrew at /opt/homebrew. Follow its administrator prompts.\n' >&2
  (unset CI NONINTERACTIVE NIX_INSTALLER_YES; /bin/bash -c "$installer") || status=$?
  # Homebrew can install CLT and select it even when full Xcode is active.
  if [[ $(/usr/bin/xcode-select -p) != "$developer" ]]; then
    printf 'Restoring the selected Apple developer directory: %s\n' "$developer" >&2
    sudo /usr/bin/xcode-select --switch "$developer"
  fi
  (( status == 0 )) || exit "$status"
  [[ -x /opt/homebrew/bin/brew ]] ||
    fail 'The installer finished, but /opt/homebrew/bin/brew is missing. Inspect its output before retrying.'
}

ensure_git_user() {
  local file="$HOME/.gitconfig.user" name email
  [[ -e "$file" ]] && return
  if [[ ! -t 0 ]]; then
    printf 'Skipping %s: no interactive terminal. Run the setup there to create it.\n' "$file" >&2
    return
  fi

  printf 'Creating %s for your Git identity.\n' "$file" >&2
  read -rp "Name [$(id -F)]: " name
  name=${name:-$(id -F)}
  while [[ -z "${email:-}" ]]; do read -rp 'Email: ' email; done

  git config --file "$file" user.name "$name"
  git config --file "$file" user.email "$email"
  printf 'Wrote %s.\n' "$file" >&2
}

ensure_clt

# Run through curl, not from a file: clone the repo, then run its copy of this script.
if [[ -z "${BASH_SOURCE[0]:-}" ]]; then
  dir="$HOME/.dotfiles"
  if [[ ! -d "$dir/.git" ]]; then
    [[ ! -e "$dir" ]] || fail "$dir exists and is not a git checkout."
    # HTTPS works without SSH keys. Use SSH for later pushes.
    git clone https://github.com/podkovyrin/dotfiles.git "$dir"
    git -C "$dir" remote set-url origin git@github.com:podkovyrin/dotfiles.git
  fi
  exec "$dir/scripts/setup" "$@"
fi

ensure_git_user
ensure_nix
nix=$(find_nix)
export PATH="$(dirname -- "$nix"):$PATH"
nix=("$nix" --extra-experimental-features 'nix-command flakes')

declared=$("${nix[@]}" eval --raw --file "$repo/nix/user.nix" \
  --apply 'user: "${user.name}\n${user.home}\n${user.dotfiles}"')
{ read -r user_name; read -r user_home; read -r user_dotfiles; } <<<"$declared"
[[ "$(id -un)" == "$user_name" && "$HOME" == "$user_home" ]] ||
  fail "Run as $user_name with HOME=$user_home, or edit nix/user.nix."
[[ "$repo" == "$user_dotfiles" ]] ||
  fail "Use the checkout at $user_dotfiles, or edit nix/user.nix."

printf 'Building the Mac configuration...\n' >&2
"${nix[@]}" build "$flake#darwinConfigurations.mac.system" --out-link "$build/system"

ensure_brew
printf 'Activating the configuration. Administrator access is required.\n' >&2
# Use darwin-rebuild from the built system, so a first run needs no installed
# copy. It evaluates the flake again as root; the build is already in the store.
sudo "$(readlink "$build/system")/sw/bin/darwin-rebuild" switch --flake "$flake#mac"
# Global mise tools: runtimes, uv, Herdr, Hunk, and Pi.
printf 'Installing global mise tools...\n' >&2
(cd "$HOME" && PATH="/etc/profiles/per-user/$user_name/bin:$PATH" mise install)
printf 'Setup complete. Open a new terminal. From now on, use ./n apply.\n' >&2
