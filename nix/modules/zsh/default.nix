# A zsh setup without a plugin manager. Nix builds one directory with the
# plugins, the shell code in ./lib, and the output of the tool init commands,
# compiles it with zcompile, and links it to ~/.config/zsh/framework.
# ~/.zshrc sources ~/.config/zsh/framework/init.zsh, then adds its own config.
#
# The plugins are flake inputs pinned to a commit (see nix/flake.nix), so they
# change only when the flake changes.
#
# Options that are read at startup are Nix options here. Settings that the
# plugins read later, for example ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE, can be set
# in ~/.zshrc after init.zsh.
{
  config,
  lib,
  pkgs,
  inputs,
  ...
}:

let
  cfg = config.dotfiles.zsh;
  inherit (lib)
    mkEnableOption
    mkIf
    mkOption
    optionalString
    types
    ;

  out = placeholder "out";
  useAbbr = cfg.abbreviations != { };

  # One line per abbreviation, in the format of the zsh-abbr user file.
  abbreviationsFile = pkgs.writeText "zsh-abbreviations" (
    lib.concatLines (
      lib.mapAttrsToList (
        name: expansion: "abbr ${lib.escapeShellArg name}=${lib.escapeShellArg expansion}"
      ) cfg.abbreviations
    )
  );

  # zsh-abbr reads its user file with one `abbr` call per line, about 10 ms at
  # startup. The build runs zsh-abbr on the file and saves the result, so at
  # startup zsh-abbr reads an empty file and init.zsh sets the saved result.
  # The build test expands each name and compares the result with this list.
  emptyFile = pkgs.writeText "zsh-abbreviations-empty" "";
  abbreviationCount = toString (lib.length (lib.attrNames cfg.abbreviations));
  expectedAbbreviations = pkgs.writeText "zsh-abbreviations-expected" ''
    typeset -A expected=(
    ${
      lib.concatLines (
        lib.mapAttrsToList (
          name: expansion: "  ${lib.escapeShellArg name} ${lib.escapeShellArg expansion}"
        ) cfg.abbreviations
      )
    })
  '';

  integration = name: package: {
    enable = mkEnableOption "the ${name} integration";
    package = mkOption {
      type = types.package;
      default = package;
      description = ''
        The ${name} package. The integration calls this binary. Except for
        mise, the build saves the output of the init command, so environment
        variables that change that output (for example _ZO_ECHO and
        _ZO_RESOLVE_SYMLINKS for zoxide) have no effect.
      '';
    };
  };

  tools = cfg.integrations;

  initFile = ''
    # Generated by nix/modules/zsh. Change the Nix options instead of this file.

    bindkey -${if cfg.keymap == "vi" then "v" else "e"}
    fpath=( ${out}/plugins/zsh-completions/src $fpath )

    source ${out}/lib/options.zsh
    source ${out}/lib/environment.zsh
    source ${out}/lib/input.zsh
    source ${out}/lib/termtitle.zsh ${lib.escapeShellArg cfg.title}
    source ${out}/lib/completion.zsh

    # The tools come before the plugins that wrap zle widgets.
    ${optionalString tools.fzf.enable ''
      source ${out}/gen/fzf.zsh
      source ${out}/lib/fzf.zsh
    ''}
    ${optionalString tools.zoxide.enable "source ${out}/gen/zoxide.zsh"}
    ${optionalString tools.starship.enable "source ${out}/gen/starship.zsh"}
    ${optionalString tools.mise.enable ''
      # The output of `mise activate` contains the current PATH, so it cannot be generated in advance.
      eval "$(${lib.getExe tools.mise.package} activate zsh)"
    ''}
    ${optionalString tools.direnv.enable ''
      # direnv puts its hook first in precmd_functions.
      source ${out}/gen/direnv.zsh
    ''}

    source ${out}/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh
    for key ('^[[A' '^P' ''${terminfo[kcuu1]}) bindkey ''${key} history-substring-search-up
    for key ('^[[B' '^N' ''${terminfo[kcud1]}) bindkey ''${key} history-substring-search-down
    unset key
    ${optionalString (cfg.keymap == "vi") ''
      bindkey -M vicmd k history-substring-search-up
      bindkey -M vicmd j history-substring-search-down
    ''}

    ${optionalString useAbbr ''
      ABBR_USER_ABBREVIATIONS_FILE=${emptyFile}
      ABBR_AUTOLOAD=0  # The file does not change while the shell runs.
      source ${out}/plugins/zsh-abbr/zsh-abbr.zsh
      source ${out}/gen/abbreviations.zsh
      ABBR_USER_ABBREVIATIONS_FILE=${abbreviationsFile}  # For `abbr load`.
      source ${out}/lib/abbr.zsh
      source ${out}/plugins/zsh-autosuggestions-abbreviations-strategy/zsh-autosuggestions-abbreviations-strategy.zsh
    ''}

    source ${out}/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

    # zsh-autosuggestions wraps the zle widgets at the first prompt. With
    # MANUAL_REBIND it does not check them again before each later prompt.
    ZSH_AUTOSUGGEST_MANUAL_REBIND=1
    (( ''${+ZSH_AUTOSUGGEST_STRATEGY} )) || ZSH_AUTOSUGGEST_STRATEGY=( ${optionalString useAbbr "abbreviations "}history completion )
    source ${out}/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

    # After the plugins, see lib/options.zsh.
    setopt NO_CASE_GLOB
  '';

  framework =
    pkgs.runCommand "zsh-framework"
      {
        inherit initFile;
        passAsFile = [ "initFile" ];
      }
      ''
        mkdir -p $out/plugins $out/gen
        cp -r ${./lib} $out/lib
        chmod -R u+w $out/lib

        plugin() {
          cp -r "$2" "$out/plugins/$1"
          chmod -R u+w "$out/plugins/$1"
        }
        plugin zsh-completions ${inputs.zsh-completions}
        plugin zsh-history-substring-search ${inputs.zsh-history-substring-search}
        plugin zsh-syntax-highlighting ${inputs.zsh-syntax-highlighting}
        plugin zsh-autosuggestions ${inputs.zsh-autosuggestions}
        ${optionalString useAbbr ''
          plugin zsh-abbr ${inputs.zsh-abbr}
          plugin zsh-autosuggestions-abbreviations-strategy ${inputs.zsh-autosuggestions-abbreviations-strategy}
          rm -rf $out/plugins/zsh-abbr/zsh-job-queue
          mkdir $out/plugins/zsh-abbr/zsh-job-queue
          cp ${./lib/job-queue-stub.zsh} $out/plugins/zsh-abbr/zsh-job-queue/zsh-job-queue.zsh

          HOME=$TMPDIR ABBR_TMPDIR=$TMPDIR/zsh-abbr/ ABBR_USER_ABBREVIATIONS_FILE=${abbreviationsFile} \
            ${lib.getExe cfg.package} -fc '
              source $1/plugins/zsh-abbr/zsh-abbr.zsh
              if (( ''${#ABBR_REGULAR_USER_ABBREVIATIONS} != $2 )); then
                print -u2 "zsh-abbr loaded ''${#ABBR_REGULAR_USER_ABBREVIATIONS} of $2 abbreviations."
                exit 1
              fi
              print -r -- "ABBR_REGULAR_USER_ABBREVIATIONS=( ''${(@kvqq)ABBR_REGULAR_USER_ABBREVIATIONS} )"
              # zsh-abbr reads this file again for each expansion.
              print -r -- "typeset -p ABBR_REGULAR_USER_ABBREVIATIONS >| \''${_abbr_tmpdir}regular-user-abbreviations"
            ' zsh-abbr $out ${abbreviationCount} > $out/gen/abbreviations.zsh

          # Test: load them the way init.zsh does, and expand each one.
          HOME=$TMPDIR ABBR_TMPDIR=$TMPDIR/zsh-abbr-test/ ABBR_USER_ABBREVIATIONS_FILE=${emptyFile} ABBR_AUTOLOAD=0 \
            ${lib.getExe cfg.package} -fc '
              source $1/plugins/zsh-abbr/zsh-abbr.zsh
              source $1/gen/abbreviations.zsh
              source ${expectedAbbreviations}
              local name actual
              for name in ''${(k)expected}; do
                actual=$(abbr expand $name)
                if [[ $actual != ''${expected[$name]} ]]; then
                  print -ru2 -- "zsh-abbr expands ''${(qq)name} to ''${(qq)actual}, expected ''${(qq)expected[$name]}."
                  exit 1
                fi
              done
            ' zsh-abbr-test $out
        ''}

        # The init code of these tools depends only on the tool version.
        export HOME=$TMPDIR
        ${optionalString tools.fzf.enable "${lib.getExe tools.fzf.package} --zsh > $out/gen/fzf.zsh"}
        ${optionalString tools.zoxide.enable "${lib.getExe tools.zoxide.package} init zsh > $out/gen/zoxide.zsh"}
        ${optionalString tools.starship.enable ''
          ${lib.getExe tools.starship.package} init zsh --print-full-init > $out/gen/starship.zsh
          # Starship runs itself at init to set PROMPT2. Run it when zsh shows PROMPT2.
          substituteInPlace $out/gen/starship.zsh \
            --replace-fail 'PROMPT2="$(' "PROMPT2='\$(" \
            --replace-fail ' prompt --continuation)"' " prompt --continuation)'"
        ''}
        ${optionalString tools.direnv.enable "${lib.getExe tools.direnv.package} hook zsh > $out/gen/direnv.zsh"}

        cp "$initFilePath" $out/init.zsh

        # A .zwc file works only with the zsh version that wrote it. Other
        # versions read the .zsh file instead.
        ${lib.getExe cfg.package} -fc '
          setopt extended_glob
          for f in $1/**/*.zsh~*/(test*|spec|docs)/*(.N); do
            zcompile -UR $f || exit 1
          done
        ' zcompile $out
      '';
in
{
  options.dotfiles.zsh = {
    enable = mkEnableOption "the zsh setup from nix/modules/zsh";

    package = mkOption {
      type = types.package;
      default = pkgs.zsh;
      description = ''
        The zsh that compiles the files. Use the zsh of the login shell:
        other versions ignore the compiled files and start more slowly.
      '';
    };

    keymap = mkOption {
      type = types.enum [
        "emacs"
        "vi"
      ];
      default = "emacs";
      description = "The zle keymap. The key bindings are made in this keymap.";
    };

    title = mkOption {
      type = types.str;
      default = "%n@%m: %~";
      description = "The terminal title, as a prompt format string.";
    };

    abbreviations = mkOption {
      type = types.attrsOf types.str;
      default = { };
      example = {
        g = "git";
        "git s" = "git status";
      };
      description = ''
        zsh-abbr abbreviations. A name can have several words. When the set is
        empty, zsh-abbr is not loaded.
      '';
    };

    integrations = {
      fzf = integration "fzf" pkgs.fzf;
      zoxide = integration "zoxide" pkgs.zoxide;
      starship = integration "Starship" pkgs.starship;
      mise = integration "mise" pkgs.mise;
      direnv = integration "direnv" config.programs.direnv.package;
    };
  };

  config = mkIf cfg.enable {
    xdg.configFile."zsh/framework".source = framework;
  };
}
