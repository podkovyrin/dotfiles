#!/bin/bash
# Day-to-day nix-darwin commands. Use ./apply to set up a new Mac.
set -euo pipefail

repo=$(cd -- "$(dirname -- "$0")" && pwd -P)
flake="path:$repo/nix"
result="$repo/.build/system"

usage() {
  printf '%s\n' \
    'Usage: ./n <command>' \
    '' \
    '  switch            Build and activate the configuration.' \
    '  build             Build only. Result in .build/system.' \
    '  diff              Build, then show package changes against the active system.' \
    '  update [input…]   Update flake inputs (all if none given), diff, confirm, switch.' \
    '  changes           Show package changes from the previous generation to the active one.' \
    '  brew              Update Homebrew, then upgrade the casks and App Store apps in the config.' \
    '  tools             Install and upgrade the global mise tools (config/mise.toml).' \
    '  rollback          Activate the previous system generation.' \
    '  gc [age]          Delete generations older than age (default 14d), then unused store paths.'
}

build() { nix build "$flake#darwinConfigurations.mac.system" --out-link "$result"; }
switch() { sudo darwin-rebuild switch --flake "$flake#mac"; }
diff() { build && nix store diff-closures /run/current-system "$result"; }

# Compare the active generation with the one before it.
changes() {
  local profiles=/nix/var/nix/profiles current prev
  current=$(readlink "$profiles/system")
  prev="$profiles/system-$(( ${current//[!0-9]/} - 1 ))-link"
  if [[ ! -e $prev ]]; then
    echo 'No previous generation found.' >&2
    exit 1
  fi
  echo "${prev##*/} -> $current"
  nix store diff-closures "$prev" "$profiles/$current"
}

# Read the Brewfile from the flake, so it matches the config even before a switch.
brew_upgrade() {
  local brewfile
  brewfile=$(nix eval --raw "$flake#darwinConfigurations.mac.config.homebrew.brewfile")
  brew update
  HOMEBREW_NO_INSTALL_CLEANUP=1 brew bundle install --file=- <<<"$brewfile"
}

# Run from $HOME, so mise reads only the global config.
tools() { (cd "$HOME" && mise install && mise upgrade); }

update() {
  nix flake update "$@" --flake "$flake"
  git -C "$repo" --no-pager diff --stat -- nix/flake.lock
  diff
  read -rp 'Switch to this configuration? [y/N] ' answer
  if [[ $answer == [yY] ]]; then switch; else echo 'Not switched. Revert with: git restore nix/flake.lock'; fi
}

case "${1:-}" in
  switch) switch ;;
  build) build ;;
  diff) diff ;;
  update) shift; update "$@" ;;
  changes) changes ;;
  brew) brew_upgrade ;;
  tools) tools ;;
  rollback) sudo darwin-rebuild switch --rollback ;;
  gc) sudo nix-collect-garbage --delete-older-than "${2:-14d}" ;;
  -h | --help | '') usage ;;
  *) printf 'Unknown command: %s. Use --help.\n' "$1" >&2; exit 2 ;;
esac
