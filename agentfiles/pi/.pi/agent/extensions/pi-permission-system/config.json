{
  "$schema": "https://cdn.jsdelivr.net/npm/@gotgenes/pi-permission-system@40.0.0/schemas/permissions.schema.json",
  "yoloMode": false,
  "doublePressToConfirm": true,
  "promptNotifications": ["bell"],
  "debugLog": false,
  "permissionReviewLog": false,
  "authorizerChain": ["soft-wrappers"],
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "path_write": {
      "*": "allow",
      "/": "deny",
      "/Users": "deny",
      "~": "deny",
      "~/projects": "ask",
      "~/.dotfiles": "ask",
      "~/Documents": "ask",
      "~/Desktop": "ask",
      "~/Library": "ask",
      "~/.ssh/*": "ask",
      "~/.gnupg/*": "ask",
      "~/.aws/*": "ask",
      "/dev/*": "ask",
      "/dev/null": "allow",
      "/dev/stdout": "allow",
      "/dev/stderr": "allow",
      "/dev/fd/*": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "ask",
      "/*/sudo *": "ask",
      "doas *": "ask",
      "/*/doas *": "ask",
      "su *": "ask",
      "/*/su *": "ask",
      "diskutil *": "ask",
      "/*/diskutil *": "ask",
      "diskutil list*": "allow",
      "diskutil info*": "allow",
      "/*/diskutil list*": "allow",
      "/*/diskutil info*": "allow",
      "rsync *--delete*": "ask",
      "git clean *": "ask",
      "git push *--force*": "ask",
      "git push -f*": "ask",
      "git push -?f*": "ask",
      "git push * -f*": "ask",
      "git push * -?f*": "ask",
      "git push *--delete*": "ask",
      "git push *--mirror*": "ask",
      "git reflog *expire*": "ask",
      "git filter-branch *": "ask",
      "git filter-repo *": "ask",
      "docker *prune*": "ask",
      "kubectl delete *": "ask",
      "terraform destroy*": "ask",
      "git reset *--hard*": "ask"
    }
  }
}
