{
  "$schema": "https://cdn.jsdelivr.net/npm/@gotgenes/pi-permission-system@40.0.0/schemas/permissions.schema.json",
  "yoloMode": false,
  "doublePressToConfirm": true,
  "promptNotifications": ["bell"],
  "debugLog": false,
  "permissionReviewLog": false,
  "permission": {
    "*": "allow",
    "external_directory": "allow",
    "path_write": {
      "*": "allow",
      "/dev/*": "ask",
      "/dev/null": "allow",
      "/dev/stdout": "allow",
      "/dev/stderr": "allow",
      "/dev/fd/*": "allow",
      "/etc/*": "ask",
      "/private/etc/*": "ask",
      "/System/*": "ask",
      "/Library/*": "ask",
      "/usr/*": "ask",
      "/bin/*": "ask",
      "/sbin/*": "ask",
      "/private/var/db/*": "ask",
      "~/.ssh/*": "ask",
      "~/.gnupg/*": "ask",
      "~/.aws/*": "ask"
    },
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "*/rm *": "ask",
      "* rm *": "ask",
      "rmdir *": "ask",
      "*/rmdir *": "ask",
      "unlink *": "ask",
      "*/unlink *": "ask",
      "dd *": "ask",
      "*/dd *": "ask",
      "* dd *": "ask",
      "shred *": "ask",
      "*/shred *": "ask",
      "wipe *": "ask",
      "*/wipe *": "ask",
      "srm *": "ask",
      "*/srm *": "ask",
      "truncate *": "ask",
      "*/truncate *": "ask",
      "mkfs*": "ask",
      "*/mkfs*": "ask",
      "newfs*": "ask",
      "*/newfs*": "ask",
      "fdisk *": "ask",
      "*/fdisk *": "ask",
      "gpt *": "ask",
      "*/gpt *": "ask",
      "parted *": "ask",
      "*/parted *": "ask",
      "diskutil *": "ask",
      "*/diskutil *": "ask",
      "diskutil list*": "allow",
      "diskutil info*": "allow",
      "*/diskutil list*": "allow",
      "*/diskutil info*": "allow",
      "sudo *": "ask",
      "*/sudo *": "ask",
      "doas *": "ask",
      "*/doas *": "ask",
      "su *": "ask",
      "*/su *": "ask",
      "chown *": "ask",
      "*/chown *": "ask",
      "chgrp *": "ask",
      "*/chgrp *": "ask",
      "chmod *-R*": "ask",
      "*/chmod *-R*": "ask",
      "chmod *--recursive*": "ask",
      "*/chmod *--recursive*": "ask",
      "chflags *": "ask",
      "*/chflags *": "ask",
      "shutdown *": "ask",
      "*/shutdown *": "ask",
      "reboot *": "ask",
      "*/reboot *": "ask",
      "halt *": "ask",
      "*/halt *": "ask",
      "poweroff *": "ask",
      "*/poweroff *": "ask",
      "kill *": "ask",
      "*/kill *": "ask",
      "killall *": "ask",
      "*/killall *": "ask",
      "pkill *": "ask",
      "*/pkill *": "ask",
      "*find *-delete*": "ask",
      "*rsync *--delete*": "ask",
      "*git *reset *": "ask",
      "*git *clean *": "ask",
      "*git *checkout *-f*": "ask",
      "*git *checkout *--force*": "ask",
      "*git *checkout * -- *": "ask",
      "*git *checkout -- *": "ask",
      "*git *restore *": "ask",
      "*git *branch *-D*": "ask",
      "*git *branch *--delete*": "ask",
      "*git *push *--force*": "ask",
      "*git *push *-f*": "ask",
      "*git *push *--delete*": "ask",
      "*git *push *--mirror*": "ask",
      "*git *push *+*": "ask",
      "*git *stash *drop*": "ask",
      "*git *stash *clear*": "ask",
      "*git *reflog *expire*": "ask",
      "*git *filter-branch *": "ask",
      "*git *filter-repo *": "ask",
      "*docker *prune*": "ask",
      "*docker *rm *": "ask",
      "*docker *rmi *": "ask",
      "*kubectl *delete *": "ask",
      "*terraform *destroy*": "ask",
      "perl *": "ask",
      "*/perl *": "ask",
      "python* *": "ask",
      "*/python* *": "ask",
      "ruby *": "ask",
      "*/ruby *": "ask",
      "lua* *": "ask",
      "*/lua* *": "ask",
      "php *": "ask",
      "*/php *": "ask",
      "osascript *": "ask",
      "*/osascript *": "ask",
      "node *": "ask",
      "*/node *": "ask",
      "node --version": "allow",
      "node -v": "allow",
      "*/node --version": "allow",
      "*/node -v": "allow",
      "python* --version": "allow",
      "*/python* --version": "allow",
      "*deno *eval *": "ask",
      "*bun *-e*": "ask",
      "*bun *--eval*": "ask",
      "*bun *-p*": "ask",
      "*bun *--print*": "ask",
      "bash *": "ask",
      "*/bash *": "ask",
      "sh *": "ask",
      "*/sh *": "ask",
      "zsh *": "ask",
      "*/zsh *": "ask",
      "dash *": "ask",
      "*/dash *": "ask",
      "ksh *": "ask",
      "*/ksh *": "ask",
      "eval *": "ask",
      "source *": "ask",
      ". *": "ask",
      "*awk *system*": "ask",
      "*awk *>*": "ask",
      "*awk *|*": "ask",
      "*sed *-i*": "ask",
      "*sed *--in-place*": "ask"
    }
  }
}
