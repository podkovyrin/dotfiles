{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "theme": "system",
  "defaultTools": [
    "+codemode"
  ],
  "showCacheMissNotices": true,
  "cacheWarming": "idle",
  "fullscreenExitOutput": "resume-hint",
  "terminal": {
    "showTerminalProgress": true
  },
  "compaction": {
    "enabled": true
  },
  "hideThinkingBlock": false,
  "selfUpdateCommand": [
    "mise",
    "upgrade",
    "npm:{packageName}"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-context-view",
    "git:github.com/nicobailon/visual-explainer",
    "npm:pi-better-render",
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/podkovyrin/pi-herdr-side",
    "npm:pi-open-tui",
    "npm:pi-browser-use",
    {
      "source": "npm:pi-subagent-manager",
      "extensions": []
    },
    "npm:pi-claude-bridge",
    {
      "source": "git:github.com/michael-denyer/pstack-claude",
      "skills": [
        "!plugins/pstack/skills/ketchup-video/**",
        "!plugins/pstack/skills/principle-*/**"
      ]
    }
  ],
  "pi-browser-use": {
    "mode": "existing",
    "userDataDir": "~/Library/Application Support/net.imput.helium"
  },
  "npmCommand": [
    "npm",
    "--min-release-age=1"
  ],
  "collapseChangelog": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "ask",
  "enabledModels": [
    "openai/gpt-6.1-sol",
    "openai/gpt-6-astra",
    "claude-bridge/claude-opus-5-5"
  ]
}
