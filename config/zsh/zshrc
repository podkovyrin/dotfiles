# My zsh lines, linked to ~/.zshrc.local. The dotkit zshrc sources this file
# at the end, after the plugins and the base aliases (ls, diff, grep).

# Word motions stop at a path separator.
WORDCHARS=${WORDCHARS//[\/]}

o() { [[ $# -gt 0 ]] && command open "$@" || command open .; }
s() { [[ $# -gt 0 ]] && subl "$@" || subl .; }
batrg() { bat "$1" | rg --color=always -C5 "$2" }

(( ${+functions[z]} )) && alias cd='z'
alias v="nvim"
