setopt HIST_IGNORE_ALL_DUPS
bindkey -v

# Guard against broken TTY input flags (Enter shows as ^M when icrnl is off).
# Some programs can leave the terminal in this state for the current session.
fix_tty_enter_key() {
  [[ -t 0 ]] || return
  stty icrnl -inlcr -igncr 2>/dev/null
}
(( ${precmd_functions[(Ie)fix_tty_enter_key]} )) || precmd_functions+=(fix_tty_enter_key)
fix_tty_enter_key

setopt CORRECT

export EDITOR="nvim"
export VISUAL="nvim"

# Word motions stop at a path separator.
WORDCHARS=${WORDCHARS//[\/]}

zstyle ':zim:termtitle' format '%~'

# Safe only while zsh-autosuggestions is the last module in ~/.zimrc.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  if (( ${+commands[curl]} )); then
    curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  else
    mkdir -p ${ZIM_HOME} && wget -nv -O ${ZIM_HOME}/zimfw.zsh \
        https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  fi
fi
# Install missing modules, and rebuild init.zsh when ~/.zimrc is newer.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZDOTDIR:-${HOME}}/.zimrc ]]; then
  source ${ZIM_HOME}/zimfw.zsh init -q
fi
source ${ZIM_HOME}/init.zsh

[[ -r ~/.config/herdr/process-name.zsh ]] && source ~/.config/herdr/process-name.zsh

# pnpm completion, from `pnpm completion zsh`. There is no global pnpm: each
# project supplies one (mise or a Nix dev shell). The function asks the pnpm on
# PATH at completion time, so it works with every project release. When pnpm
# has no values (for example after `pnpm add ./`), complete file names.
_pnpm_completion() {
  (( ${+commands[pnpm]} )) || return 1
  local -a reply
  reply=("${(@f)$(COMP_CWORD=$((CURRENT-1)) COMP_LINE="$BUFFER" COMP_POINT="$CURSOR" SHELL=zsh pnpm completion-server -- "${words[@]}" 2>/dev/null)}")
  reply=( ${reply:#} )
  if (( ! $#reply )) || [[ ${reply[1]} == __tabtab_complete_files__ ]]; then
    _files
  else
    _describe 'values' reply
  fi
}
compdef _pnpm_completion pnpm pn

ZSH_AUTOSUGGEST_STRATEGY=( abbreviations history completion )
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=243,underline"

zmodload -F zsh/terminfo +p:terminfo
# Bind ^[[A/^[[B manually so up/down works both before and after zle-line-init.
for key ('^[[A' '^P' ${terminfo[kcuu1]}) bindkey ${key} history-substring-search-up
for key ('^[[B' '^N' ${terminfo[kcud1]}) bindkey ${key} history-substring-search-down
for key ('k') bindkey -M vicmd ${key} history-substring-search-up
for key ('j') bindkey -M vicmd ${key} history-substring-search-down
unset key

ls() { command -v eza &> /dev/null && eza "$@" || command ls -G "$@"; }
o() { [[ $# -gt 0 ]] && command open "$@" || command open .; }
s() { [[ $# -gt 0 ]] && subl "$@" || subl .; }
batrg() { bat "$1" | rg --color=always -C5 "$2" }

alias diff='diff --color=auto'
alias grep='grep --color=auto'
alias cd='z'
alias v="nvim"

(( ${+commands[zoxide]} )) && eval "$(zoxide init zsh)"
(( ${+commands[starship]} )) && eval "$(starship init zsh)"

# Activate mise in every interactive shell, not only login shells.
# Keep direnv after mise and the prompt setup.
(( ${+commands[mise]} )) && eval "$(mise activate zsh)"
(( ${+commands[direnv]} )) && eval "$(direnv hook zsh)"

# VSCode workaround
if [[ "$TERM_PROGRAM" == "vscode" ]]; then
  . "$(code --locate-shell-integration-path zsh)"
fi
