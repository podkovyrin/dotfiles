# My login shell lines, linked to ~/.zprofile.local. The dotkit zprofile
# sources this file before it puts the global tool directories first in PATH.

[[ -r "$HOME/.orbstack/shell/init.zsh" ]] && source "$HOME/.orbstack/shell/init.zsh"
[[ -r "$HOME/.secrets" ]] && source "$HOME/.secrets"

# Drop the Pi launcher directory, which would shadow the mise tools.
path=( ${path:#$HOME/.pi/agent/bin} )

# dotkit uses this dotkit checkout instead of the release in nix/flake.lock.
# nix/home.nix links the base config files to it too (dotkit.liveDir).
export DOTKIT_DIR=$HOME/.dotkit
