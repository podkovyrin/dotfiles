// Tasks for this repository. The flake is in nix/, so the global
// "nix: flake check" task does not work here.
[
    {
        "label": "dotfiles: apply -n",
        "command": "./dotkit",
        "args": ["apply", "-n"],
        "cwd": "$ZED_WORKTREE_ROOT",
    },
    {
        "label": "dotfiles: apply",
        "command": "./dotkit",
        "args": ["apply"],
        "cwd": "$ZED_WORKTREE_ROOT",
    },
    {
        "label": "dotfiles: upgrade -n",
        "command": "./dotkit",
        "args": ["upgrade", "-n"],
        "cwd": "$ZED_WORKTREE_ROOT",
    },
    {
        "label": "dotfiles: flake check",
        "command": "nix",
        "args": ["flake", "check", "path:./nix"],
        "cwd": "$ZED_WORKTREE_ROOT",
    },
]
